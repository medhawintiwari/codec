#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while (t--) {
        int n;
        long long m;
        cin >>n >>m;
        vector<int> a(n);
        for (int i = 0; i < n; i++) cin >> a[i];
        sort(a.begin(), a.end());
        int c = 0;
        long long p = 0;
        for (int i = 0; i < n; i++) {
            long long np = p + a[i];
            if (np*(np - 1) / 2 <= m) {
                p=np;
                c++;
            } 
            else {
                break;
            }
        }
        cout <<c<< endl;
    }
    return 0;
}