#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while (t--) {
        int n;
        cin >>n;
        
        int f[2] = {-2,-2};
        
        f[0]= -1;
        
        int pr = 0;
        int ans = 0;
        
        for(int i = 0; i<n; i++){
            int x;
            cin>>x;
            
            if(x%2 != 0){
                pr^= 1;
            }
            if(f[pr] != -2){
                ans = max(ans, i - f[pr]);
            }
            else{
                f[pr] = i;
            }
        }
        cout << ans << endl;
    }
    return 0;
}
