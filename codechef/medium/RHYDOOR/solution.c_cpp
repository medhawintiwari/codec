#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string s;
        cin >> s;
        int count = 0;
        int streak = 0;
        char last = ' ';
        for (int i = 0; i < n; i++) {
            if (s[i] == last) {
                streak++;
            } else {
                last = s[i];
                streak = 1;
            }
            if (streak == 3) {
                count++;
                streak = 0;
                last = ' ';
            }
        }
        cout << count << "\n";
    }
    return 0;
}