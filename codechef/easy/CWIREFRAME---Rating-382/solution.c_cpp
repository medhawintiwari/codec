#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int x, y;
        cin >> x >> y;
        int d = 3 * x;
        int tr = 2 * y;
        if (d < tr) {
            cout << d << endl;
        } else {
            cout << tr << endl;
        }
    }
    return 0;
}