#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        string s;
        cin >> s;
        int first_digit = s[0] - '0';
        int last_digit = s[s.length() - 1] - '0';
        cout << first_digit + last_digit << endl;
    }
    return 0;
}
